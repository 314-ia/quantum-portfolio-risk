# Credenciales de IBM Quantum para la sección 7.2 del notebook.
# 1) Copiá este archivo con el nombre  .env  (en esta misma carpeta).
# 2) Completá los valores. El archivo .env es personal: no lo compartas ni lo subas a un repositorio.
#
# La API key y la instancia (CRN) se obtienen en https://quantum.cloud.ibm.com
IBM_API_KEY=
IBM_INSTANCE=
IBM_CHANNEL=ibm_quantum_platform
